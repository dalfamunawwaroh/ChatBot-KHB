// ================================================================
// KHB Halal Assistant — Prisma schema
// Stack & pola sama dengan backend AiOnesCare (omnicare): MySQL + Prisma,
// tabel snake_case, id UUID, kolom created_at/updated_at.
// Bedanya: satu deployment KHB melayani satu komunitas (single workspace),
// jadi tidak ada tabel tenant/user/agent. Login belum punya backend.
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ChannelPlatform {
  whatsapp
  instagram
  web
  telegram
}

enum ChannelStatus {
  draft
  active
  inactive
  error
}

enum ConversationStatus {
  bot
  pending_human
  resolved
}

enum SenderType {
  customer
  bot
  agent
  system
}

/// Dari mana jawaban bot berasal — transparan ke UI.
enum MessageSource {
  /// Dijawab dari dokumen RAG (grounded).
  rag
  /// Dijawab LLM umum, di luar dokumen KHB.
  general
  /// Diteruskan ke pendamping (tidak ada jawaban).
  handoff
  /// Pesan pengguna / sistem, bukan jawaban AI.
  none
}

enum KnowledgeKind {
  pdf
  web
  text
}

enum KnowledgeStatus {
  indexed
  processing
  failed
}

enum ProductHalal {
  certified
  process
  none
}

enum FlowNodeKind {
  greeting
  question
  answer
  escalation
}

enum NotificationType {
  chat
  knowledge
  system
  channel
}

model Workspace {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(80)
  city      String?  @db.VarChar(80)
  tagline   String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  settings      ChatbotSetting?
  channels      Channel[]
  products      Product[]
  customers     Customer[]
  conversations Conversation[]
  documents     KnowledgeDocument[]
  flowNodes     FlowNode[]
  notifications Notification[]

  @@map("workspaces")
}

/// Pengaturan asisten: identitas, gaya jawaban, dan kebijakan jawaban AI.
model ChatbotSetting {
  id        String   @id @default(uuid()) @db.Char(36)
  workspaceId String @unique @map("workspace_id") @db.Char(36)

  assistantName String @default("Asisten Halal KHB") @map("assistant_name") @db.VarChar(120)
  greeting      String @db.Text
  language      String @default("Bahasa Indonesia") @db.VarChar(60)
  tone          String @default("Ramah & ringkas") @db.VarChar(60)
  fallbackMode  String @default("Eskalasi ke Pendamping PPH") @map("fallback_mode") @db.VarChar(60)
  showSources   Boolean @default(true) @map("show_sources")
  autoEscalate  Boolean @default(true) @map("auto_escalate")
  requestContact Boolean @default(false) @map("request_contact")

  /// Fitur utama KHB: boleh menjawab pertanyaan umum di luar dokumen RAG.
  allowGeneralKnowledge Boolean @default(true) @map("allow_general_knowledge")
  /// Tandai jawaban umum dengan catatan "bukan dari dokumen KHB".
  generalDisclaimer     Boolean @default(true) @map("general_disclaimer")

  model       String? @db.VarChar(120)
  temperature Float   @default(0.3) @db.Float

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("chatbot_settings")
}

model KnowledgeDocument {
  id          String          @id @default(uuid()) @db.Char(36)
  workspaceId String          @map("workspace_id") @db.Char(36)
  title       String          @db.VarChar(200)
  fileName    String?         @map("file_name") @db.VarChar(200)
  kind        KnowledgeKind   @default(text)
  category    String          @default("Umum") @db.VarChar(80)
  /// Teks lengkap dokumen — dipakai sebagai konteks retrieval lokal.
  content     String          @db.LongText
  sizeKb      Int             @default(0) @map("size_kb")
  pages       Int?
  chunkCount  Int             @default(0) @map("chunk_count")
  status      KnowledgeStatus @default(indexed)
  /// ID dokumen di layanan RAG/KMS bila sudah disinkronkan.
  ragDocumentId String?       @map("rag_document_id") @db.VarChar(80)
  indexedAt   DateTime?       @map("indexed_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status], map: "idx_documents_workspace_status")
  @@map("knowledge_documents")
}

model Product {
  id          String       @id @default(uuid()) @db.Char(36)
  workspaceId String       @map("workspace_id") @db.Char(36)
  name        String       @db.VarChar(200)
  sku         String?      @db.VarChar(60)
  category    String       @default("Makanan Ringan") @db.VarChar(80)
  price       String?      @db.VarChar(40)
  halal       ProductHalal @default(none)
  description String?      @db.Text
  isActive    Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name], map: "uq_products_workspace_name")
  @@map("products")
}

model Channel {
  id          String        @id @default(uuid()) @db.Char(36)
  workspaceId String        @map("workspace_id") @db.Char(36)
  platform    ChannelPlatform
  name        String        @db.VarChar(120)
  handle      String?       @db.VarChar(120)
  status      ChannelStatus @default(draft)
  lastSyncAt  DateTime?     @map("last_sync_at") @db.DateTime(3)
  messageCount Int          @default(0) @map("message_count")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId, status], map: "idx_channels_workspace_status")
  @@map("channels")
}

model Customer {
  id          String   @id @default(uuid()) @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  name        String   @db.VarChar(150)
  business    String?  @db.VarChar(150)
  city        String?  @db.VarChar(80)
  chatCount   Int      @default(0) @map("chat_count")
  /// "Aktif" | "Baru" — disimpan sebagai teks agar mudah diubah tim KHB.
  status      String   @default("Baru") @db.VarChar(20)
  lastSeenAt  DateTime? @map("last_seen_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId, status], map: "idx_customers_workspace_status")
  @@map("customers")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Char(36)
  workspaceId String             @map("workspace_id") @db.Char(36)
  channelId   String?            @map("channel_id") @db.Char(36)
  customerId  String?            @map("customer_id") @db.Char(36)
  customerName String?           @map("customer_name") @db.VarChar(150)
  /// Kunci sesi dari widget (localStorage) agar riwayat tidak tercampur.
  sessionKey  String?            @map("session_key") @db.VarChar(80)
  status      ConversationStatus @default(bot)
  lastMessageAt DateTime?        @map("last_message_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([workspaceId, lastMessageAt(sort: Desc)], map: "idx_conversations_workspace_recent")
  @@index([workspaceId, sessionKey], map: "idx_conversations_session")
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Char(36)
  conversationId String      @map("conversation_id") @db.Char(36)
  senderType     SenderType  @map("sender_type")
  text           String      @db.LongText
  source         MessageSource @default(none)
  grounded       Boolean     @default(false)
  /// Skor keyakinan 0–1: 0.9 dari RAG grounded, ~0.55 untuk jawaban umum.
  confidence     Float?
  /// Daftar sitasi dokumen yang dipakai (JSON array of string).
  citations      Json?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "idx_messages_conversation")
  @@map("messages")
}

model FlowNode {
  id          String       @id @default(uuid()) @db.Char(36)
  workspaceId String       @map("workspace_id") @db.Char(36)
  kind        FlowNodeKind @default(question)
  title       String       @db.VarChar(150)
  description String       @db.Text
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sortOrder], map: "idx_flow_nodes_order")
  @@map("flow_nodes")
}

model Notification {
  id          String           @id @default(uuid()) @db.Char(36)
  workspaceId String           @map("workspace_id") @db.Char(36)
  type        NotificationType @default(system)
  title       String           @db.VarChar(200)
  description String           @db.Text
  isRead      Boolean          @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isRead, createdAt(sort: Desc)], map: "idx_notifications_workspace")
  @@map("notifications")
}
