# ── Database (MySQL, mis. Laragon) ─────────────────────────────
DATABASE_URL="mysql://root@localhost:3306/khb_chatbot"

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3100,http://localhost:5173
APP_NAME=khb-halal-assistant

# ── RAG (penjawab chat) + KMS (unggah dokumen) ────────────────
# Kosong = retrieval lokal dari tabel knowledge_documents.
RAG_CHAT_API_URL=https://rag.aiones.app
RAG_CHAT_API_KEY=
RAG_CHAT_KNOWLEDGE_BASE_ID=
# KMS: unggahan dokumen masuk ke project organisasi (panel knowbase)
RAG_API_URL=https://ragkms.aiones.app
RAG_API_KEY=
KMS_ORGANIZATION_ID=
KMS_OWNER_EMAIL=
KMS_OWNER_NAME=
KMS_DOCUMENT_CATEGORY=Panduan Halal

# ── LLM umum (OpenAI-compatible) ──────────────────────────────
# Wajib bila ingin asisten bisa menjawab pertanyaan di luar dokumen.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_TEMPERATURE=0.3

LOG_LEVEL=info
