# ── Database (MySQL, mis. Laragon) ─────────────────────────────
DATABASE_URL="mysql://root@localhost:3306/khb_chatbot"

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3100,http://localhost:5173
APP_NAME=khb-halal-assistant

# ── RAG (opsional) ────────────────────────────────────────────
# Kosong = pakai retrieval lokal dari tabel knowledge_documents.
RAG_CHAT_API_URL=
RAG_CHAT_API_KEY=
RAG_CHAT_KNOWLEDGE_BASE_ID=
RAG_API_URL=
RAG_API_KEY=

# ── LLM umum (OpenAI-compatible) ──────────────────────────────
# Wajib bila ingin asisten bisa menjawab pertanyaan di luar dokumen.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_TEMPERATURE=0.3

LOG_LEVEL=info
